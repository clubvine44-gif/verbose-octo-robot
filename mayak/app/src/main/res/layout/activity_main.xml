<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0E1014">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MAYAK"
            android:textColor="#F4F5F8"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Простое подключение к защищённому серверу"
            android:textColor="#9298A5"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/mayak_panel"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Состояние"
                android:textColor="#9298A5"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Не подключено"
                android:textColor="#F4F5F8"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Выберите сервер и нажмите подключение"
                android:textColor="#9298A5"
                android:textSize="13sp" />

            <Button
                android:id="@+id/toggle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/mayak_button"
                android:text="Подключиться"
                android:textAllCaps="false"
                android:textColor="#101218"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/mayak_panel"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Сервер"
                android:textColor="#F4F5F8"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/relayHost"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:hint="Адрес сервера"
                android:inputType="textUri"
                android:singleLine="true"
                android:textColor="#F4F5F8"
                android:textColorHint="#666C78" />

            <EditText
                android:id="@+id/relayPort"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:hint="Порт"
                android:inputType="number"
                android:singleLine="true"
                android:text="443"
                android:textColor="#F4F5F8"
                android:textColorHint="#666C78" />

            <EditText
                android:id="@+id/relayToken"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:hint="Ключ доступа"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="#F4F5F8"
                android:textColorHint="#666C78" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Ключ хранится на устройстве в защищённом хранилище Android."
                android:textColor="#666C78"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="MAYAK создаёт VPN-подключение Android и передаёт IPv4-трафик через настроенный relay."
            android:textColor="#666C78"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
