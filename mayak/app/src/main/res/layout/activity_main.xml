<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="28dp" android:gravity="center" android:background="#101114" android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:text="MAYAK" android:textColor="#FFFFFF" android:textSize="38sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:text="Transport Engine v0.2" android:textColor="#A9ACB5" android:textSize="15sp" android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <EditText android:id="@+id/relayHost" android:hint="Relay host" android:textColor="#FFFFFF" android:singleLine="true" android:inputType="textUri" android:layout_marginTop="32dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <EditText android:id="@+id/relayPort" android:hint="Relay port" android:text="443" android:textColor="#FFFFFF" android:singleLine="true" android:inputType="number" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <EditText android:id="@+id/relayToken" android:hint="Relay access token" android:textColor="#FFFFFF" android:singleLine="true" android:inputType="textPassword" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/status" android:text="Статус: выключен" android:textColor="#FFFFFF" android:textSize="18sp" android:layout_marginTop="32dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <Button android:id="@+id/toggle" android:text="Запустить MAYAK" android:layout_marginTop="20dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:text="TUN → Traffic Router → TLS 1.3 framing → authenticated Relay. IPv4 проходит через транспорт; IPv6 пока блокируется без утечки в обычную сеть." android:textColor="#A9ACB5" android:textSize="14sp" android:gravity="center" android:layout_marginTop="28dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>
